@model KpiReport.Web.Models.UserListViewModel
@{
    ViewBag.Title = "Users";
}

<div class="kpi-page-head">
    <div>
        <h2>User management</h2>
        <p class="kpi-subtitle">@Model.TotalUsers accounts &middot; administrators only</p>
    </div>
    <div class="kpi-toolbar">
        @using (Html.BeginForm("Index", "Users", FormMethod.Get, new { @class = "kpi-toolbar", style = "margin:0;" }))
        {
            <input type="search" name="q" value="@Model.Query" class="form-control"
                   placeholder="ค้นหาอีเมล" aria-label="Search users" />
            <button type="submit" class="btn-kpi-outline">Search</button>
            @if (Model.IsFiltered)
            {
                <a class="btn-kpi-sm" href="@Url.Action("Index", "Users")">Clear</a>
            }
        }
        <span class="kpi-divider"></span>
        <a class="btn-kpi" href="@Url.Action("Create", "Users")">&#43; New user</a>
    </div>
</div>

@if (TempData["UserMessage"] != null)
{
    <div class="alert alert-info">@TempData["UserMessage"]</div>
}
@if (TempData["UserError"] != null)
{
    <div class="alert alert-danger">@TempData["UserError"]</div>
}

<div class="kpi-stat-row">
    <div class="kpi-stat">
        <p class="kpi-stat-label">Active</p>
        <p class="kpi-stat-value">@Model.CountActive</p>
    </div>
    <div class="kpi-stat">
        <p class="kpi-stat-label">Disabled</p>
        <p class="kpi-stat-value">@Model.CountDisabled</p>
    </div>
    <div class="kpi-stat @(Model.CountNeedsAttention > 0 ? "is-red" : "")">
        <p class="kpi-stat-label">Needs setup</p>
        <p class="kpi-stat-value">@Model.CountNeedsAttention</p>
    </div>
</div>

@if (Model.CountNeedsAttention > 0)
{
    <div class="alert alert-warning">
        บางบัญชียังไม่มีสิทธิ์ หรือเป็น Viewer ที่ยังไม่ผูกแผนก — บัญชีเหล่านี้ login ได้แต่จะไม่เห็นข้อมูลใด ๆ
    </div>
}

<div class="kpi-table-wrap">
    <table class="kpi-table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Role</th>
                <th>Department</th>
                <th>Status</th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>
                        <strong>@user.Email</strong>
                        @if (user.IsCurrentUser)
                        {
                            <span class="kpi-badge kpi-badge-default" style="margin-left:6px;">YOU</span>
                        }
                    </td>
                    <td>
                        @if (string.IsNullOrEmpty(user.Role))
                        {
                            <span class="kpi-badge kpi-badge-red">NO ROLE</span>
                        }
                        else
                        {
                            <span class="kpi-badge @(user.Role == "Admin" ? "kpi-badge-yellow" : "kpi-badge-default")">@user.Role.ToUpper()</span>
                        }
                    </td>
                    <td>
                        @if (user.DepartmentId.HasValue)
                        {
                            @user.DepartmentName
                        }
                        else if (user.Role == "Viewer")
                        {
                            <span class="kpi-badge kpi-badge-red">NOT SET</span>
                        }
                        else
                        {
                            <span class="kpi-muted-cell">All departments</span>
                        }
                    </td>
                    <td>
                        @if (user.IsDisabled)
                        {
                            <span class="kpi-badge kpi-badge-red">DISABLED</span>
                        }
                        else
                        {
                            <span class="kpi-badge kpi-badge-green">ACTIVE</span>
                        }
                    </td>
                    <td class="kpi-row-actions">
                        <a class="btn-kpi-sm" href="@Url.Action("Edit", "Users", new { id = user.UserId })">Edit</a>
                        <a class="btn-kpi-sm" href="@Url.Action("ResetPassword", "Users", new { id = user.UserId })">Reset password</a>

                        @if (!user.IsCurrentUser)
                        {
                            using (Html.BeginForm("ToggleActive", "Users", FormMethod.Post, new { style = "display:inline;" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", user.UserId)
                                <button type="submit" class="btn-kpi-sm @(user.IsDisabled ? "" : "is-danger")">
                                    @(user.IsDisabled ? "Enable" : "Disable")
                                </button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalCount == 0)
{
    <p class="kpi-empty">ไม่พบบัญชีที่ตรงกับ &ldquo;@Model.Query&rdquo;</p>
}

@if (Model.TotalCount > 0)
{
    <div class="kpi-pager">
        <span class="kpi-pager-info">
            แสดง @Model.FirstRowNumber&ndash;@Model.LastRowNumber จาก @Model.TotalCount
            @if (Model.IsFiltered)
            {
                <text>(กรองจากทั้งหมด @Model.TotalUsers)</text>
            }
        </span>

        @if (Model.TotalPages > 1)
        {
            <span class="kpi-pager-nav">
                @if (Model.HasPrevious)
                {
                    <a class="btn-kpi-sm" href="@Url.Action("Index", "Users", new { q = Model.Query, page = Model.Page - 1 })">&larr; Previous</a>
                }
                else
                {
                    <span class="btn-kpi-sm is-off">&larr; Previous</span>
                }

                <span class="kpi-pager-page">หน้า @Model.Page / @Model.TotalPages</span>

                @if (Model.HasNext)
                {
                    <a class="btn-kpi-sm" href="@Url.Action("Index", "Users", new { q = Model.Query, page = Model.Page + 1 })">Next &rarr;</a>
                }
                else
                {
                    <span class="btn-kpi-sm is-off">Next &rarr;</span>
                }
            </span>
        }
    </div>
}

<p class="kpi-subtitle" style="margin-top:14px;">
    บัญชีถูก "ปิดใช้งาน" ไม่ใช่ลบทิ้ง เพราะ audit log อ้างถึง UserId อยู่ —
    ลบแล้วประวัติจะชี้ไปยังบัญชีที่ไม่มีตัวตน ทุกการเปลี่ยนแปลงในหน้านี้ถูกบันทึกลง <code>meta.AuditLog</code>
</p>
