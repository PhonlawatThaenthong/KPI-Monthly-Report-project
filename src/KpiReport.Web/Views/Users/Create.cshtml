@model KpiReport.Web.Models.UserCreateViewModel
@{
    ViewBag.Title = "New user";
}

<div class="kpi-page-head">
    <div>
        <h2>New user</h2>
        <p class="kpi-subtitle">Create the account, assign its role and department in one step</p>
    </div>
    <div class="kpi-toolbar">
        <a class="btn-kpi-outline" href="@Url.Action("Index", "Users")">Back to users</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-7">
        <div class="kpi-panel">
            @using (Html.BeginForm("Create", "Users", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email)
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "name@company.com", autofocus = "autofocus" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.Password)
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.ConfirmPassword)
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Role)
                    @Html.DropDownListFor(m => m.Role,
                        new SelectList(new[] { "Admin", "Manager", "Viewer" }, Model.Role),
                        new { @class = "form-control", id = "roleSelect" })
                    @Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3" id="departmentRow">
                    @Html.LabelFor(m => m.DepartmentId)
                    @Html.DropDownListFor(m => m.DepartmentId,
                        new SelectList(Model.Departments, "DepartmentId", "DepartmentName", Model.DepartmentId),
                        "— เลือกแผนก —",
                        new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.DepartmentId, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn-kpi">Create user</button>
            }
        </div>
    </div>

    <div class="col-md-5">
        <div class="kpi-panel">
            <h3>Roles</h3>
            <p class="kpi-subtitle" style="margin-bottom:12px;">
                <strong>Admin</strong> — sees every department and manages users.<br />
                <strong>Manager</strong> — sees every department, no user management.<br />
                <strong>Viewer</strong> — sees one department only, and must be bound to it.
            </p>
            <h3>Password</h3>
            <p class="kpi-subtitle">
                At least 6 characters with an uppercase letter, a lowercase letter, a digit and a
                symbol. Hand it over through a channel the person already trusts, and ask them to
                change it from <em>My account</em> as soon as they are in.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        // ช่องแผนกมีความหมายเฉพาะกับ Viewer — Admin/Manager เห็นทุกแผนกอยู่แล้ว
        // ซ่อนไว้เฉย ๆ ฝั่งหน้าจอ ส่วนการตรวจจริงอยู่ที่ ValidateRoleAndDepartment ฝั่ง server
        (function () {
            var role = document.getElementById('roleSelect');
            var row = document.getElementById('departmentRow');
            if (!role || !row) { return; }

            function sync() { row.style.display = role.value === 'Viewer' ? '' : 'none'; }
            role.addEventListener('change', sync);
            sync();
        })();
    </script>
}
