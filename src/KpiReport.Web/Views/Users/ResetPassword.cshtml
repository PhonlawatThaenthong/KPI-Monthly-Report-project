@model KpiReport.Web.Models.ResetPasswordAdminViewModel
@{
    ViewBag.Title = "Reset password";
}

<div class="kpi-auth">
    <div class="kpi-panel">
        <div class="kpi-auth-head">
            <h2>Reset password</h2>
            <p>@Model.Email</p>
        </div>

        @using (Html.BeginForm("ResetPassword", "Users", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.UserId)
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.NewPassword)
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.ConfirmPassword)
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>

            <div class="alert alert-warning" style="margin-bottom:14px;">
                รหัสนี้เป็น <strong>รหัสชั่วคราว</strong> — ระบบจะบังคับให้เจ้าของบัญชีตั้งรหัสใหม่ของตัวเอง
                ทันทีที่เข้าระบบครั้งถัดไป ก่อนทำอย่างอื่นได้ ส่งรหัสนี้ให้เขาผ่านช่องทางที่ปลอดภัย
                และทุก session เดิมของบัญชีนี้จะถูกตัดออกทันที
            </div>

            <button type="submit" class="btn-kpi" style="width:100%; justify-content:center;">Reset password</button>
        }

        <p style="text-align:center; margin:14px 0 0;">
            <a href="@Url.Action("Index", "Users")">Cancel</a>
        </p>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
