@model KpiReport.Web.Models.IndexViewModel
@{
    ViewBag.Title = "My account";
}

<div class="kpi-page-head">
    <div>
        <h2>My account</h2>
        <p class="kpi-subtitle">@User.Identity.Name</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.StatusMessage))
{
    <div class="alert alert-info">@ViewBag.StatusMessage</div>
}

<div class="row g-3">
    <div class="col-md-6">
        <div class="kpi-panel">
            <h3>Password</h3>
            <p class="kpi-subtitle" style="margin-bottom:16px;">
                Choose a password you do not use anywhere else. Changing it signs out
                every other device that is still logged in as you.
            </p>
            <a class="btn-kpi" href="@Url.Action("ChangePassword", "Manage")">Change password</a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="kpi-panel">
            <h3>Access and departments</h3>
            <p class="kpi-subtitle">
                Your role and the departments you can see are assigned by an administrator
                and cannot be changed here. If the dashboard shows nothing or shows the
                wrong department, contact the HR Analytics team.
            </p>
        </div>
    </div>
</div>
