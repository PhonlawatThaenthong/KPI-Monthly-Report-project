@model KpiReport.Web.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Change password";
}

<div class="kpi-auth">
    <div class="kpi-panel">
        <div class="kpi-auth-head">
            <h2>Change password</h2>
            <p>@User.Identity.Name</p>
        </div>

        @if (TempData["ForcePasswordChange"] != null)
        {
            <div class="alert alert-warning">@TempData["ForcePasswordChange"]</div>
        }

        @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()

            @* กล่องเดียวทำสองหน้าที่ — ขึ้นเกณฑ์รหัสผ่านให้ครบตั้งแต่เปิดหน้า
               และรับ error จริงมาแสดงไว้ด้านบนของกล่องเดิมเมื่อ submit ไม่ผ่าน
               ไม่แยกสองกล่องแดง เพราะผู้ใช้จะอ่านซ้ำสองรอบ *@
            <div class="alert alert-danger">
                @Html.ValidationSummary("", new { @class = "kpi-vsum" })

                <strong>รหัสผ่านใหม่ต้องมี</strong>
                <ul class="kpi-req-list">
                    <li>ความยาวอย่างน้อย 6 ตัวอักษร</li>
                    <li>ตัวพิมพ์ใหญ่ (A–Z) อย่างน้อย 1 ตัว</li>
                    <li>ตัวพิมพ์เล็ก (a–z) อย่างน้อย 1 ตัว</li>
                    <li>ตัวเลข (0–9) อย่างน้อย 1 ตัว</li>
                    <li>อักขระพิเศษ อย่างน้อย 1 ตัว เช่น ! @@ # $ %</li>
                </ul>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.OldPassword)
                @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.NewPassword)
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.ConfirmPassword)
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn-kpi" style="width:100%; justify-content:center;">Change password</button>
        }

        <p style="text-align:center; margin:14px 0 0;">
            <a href="@Url.Action("Index", "Manage")">Back to my account</a>
        </p>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
