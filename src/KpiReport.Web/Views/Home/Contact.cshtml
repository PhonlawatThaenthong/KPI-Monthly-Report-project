@{
    ViewBag.Title = "Contact";
}

<div class="kpi-page-head">
    <div>
        <h2>Contact</h2>
        <p class="kpi-subtitle">@ViewBag.Message</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="kpi-panel">
            <h3>System owner</h3>
            <p>
                HR Analytics Team<br />
                Internal extension 1200
            </p>
            <p>
                <strong>Support:</strong> <a href="mailto:hr-kpi-support@example.com">hr-kpi-support@example.com</a>
            </p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="kpi-panel">
            <h3>Reporting a data issue</h3>
            <p>
                If a KPI looks wrong, include the KPI code, the department and the month
                shown on the card. That is enough to trace the figure back through the
                pipeline to its source file.
            </p>
        </div>
    </div>
</div>
