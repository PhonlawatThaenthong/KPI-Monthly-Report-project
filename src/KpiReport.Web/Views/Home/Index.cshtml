@{
    ViewBag.Title = "Home";
}

<main>
    <section class="kpi-hero">
        <h1>HR KPI Monitoring System</h1>
        <p>
            Monthly HR and operations KPIs consolidated from attendance, downtime and cost sources
            into one reviewed figure per department &mdash; ready to read, compare and export.
        </p>
        <a class="btn-kpi-outline" href="@Url.Action("Index", "Dashboard")">Open Dashboard &raquo;</a>
    </section>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="kpi-feature">
                <h3>One monthly figure</h3>
                <p>
                    Each KPI is calculated once by the ETL pipeline and stored, so the dashboard,
                    the Excel file and the PDF always show the same number.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-feature">
                <h3>Target and trend</h3>
                <p>
                    Every card shows actual against target, achievement, month-over-month change
                    and a twelve-month trend line.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-feature">
                <h3>Scoped by permission</h3>
                <p>
                    Viewers see only their own department. Managers and administrators see the
                    company view plus the department breakdown.
                </p>
            </div>
        </div>
    </div>
</main>
