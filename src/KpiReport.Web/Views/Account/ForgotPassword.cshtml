@model KpiReport.Web.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "ลืมรหัสผ่าน";
}

<div class="kpi-auth">
    <div class="kpi-panel">
        <div class="kpi-auth-head">
            <h2>ลืมรหัสผ่าน</h2>
            <p>กรอกอีเมลที่ใช้เข้าระบบ เราจะส่งลิงก์ตั้งรหัสผ่านใหม่ไปให้</p>
        </div>

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "name@company.com", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn-kpi" style="width:100%; justify-content:center;">ส่งลิงก์ตั้งรหัสผ่านใหม่</button>
        }

        <p style="text-align:center; margin:14px 0 0;">
            <a href="@Url.Action("Login", "Account")">กลับไปหน้าเข้าสู่ระบบ</a>
        </p>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
