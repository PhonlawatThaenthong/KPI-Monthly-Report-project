@model KpiReport.Web.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "ตั้งรหัสผ่านใหม่";
}

<div class="kpi-auth">
    <div class="kpi-panel">
        <div class="kpi-auth-head">
            <h2>ตั้งรหัสผ่านใหม่</h2>
            <p>เลือกรหัสผ่านที่ไม่ได้ใช้กับที่อื่น</p>
        </div>

        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.UserId)
            @Html.HiddenFor(m => m.Code)
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.ConfirmPassword)
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>

            <p class="kpi-subtitle" style="margin-bottom:14px;">
                อย่างน้อย 6 ตัวอักษร มีตัวพิมพ์ใหญ่ พิมพ์เล็ก ตัวเลข และอักขระพิเศษอย่างละอย่างน้อยหนึ่งตัว
            </p>

            <button type="submit" class="btn-kpi" style="width:100%; justify-content:center;">บันทึกรหัสผ่านใหม่</button>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
