@model KpiReport.Web.Models.RegisterViewModel
@{
    ViewBag.Title = "Create account";
}

<div class="kpi-page-head">
    <div>
        <h2>Create account</h2>
        <p class="kpi-subtitle">Administrators only &middot; the new user will not be signed in</p>
    </div>
</div>

@if (TempData["AccountMessage"] != null)
{
    <div class="alert alert-info">@TempData["AccountMessage"]</div>
}

<div class="row">
    <div class="col-md-6">
        <div class="kpi-panel">
            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new { @class = "alert alert-danger" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email)
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "name@company.com" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Password)
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.ConfirmPassword)
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn-kpi">Create account</button>
            }
        </div>
    </div>

    <div class="col-md-6">
        <div class="kpi-panel">
            <h3>After creating the account</h3>
            <p>
                A new account has no role and no department until it is assigned one, so it
                can sign in but will see nothing. Assign the role and, for a viewer, the
                department binding in <code>meta.UserDepartment</code> before handing the
                account over.
            </p>
            <p class="kpi-subtitle">
                Account creation is recorded in the audit log as <code>USER_CREATED</code>.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
