@{
    ViewBag.Title = "Error";
}

<div class="kpi-auth">
    <div class="kpi-panel" style="text-align:center;">
        <h2>Something went wrong</h2>
        <p class="kpi-subtitle" style="margin:8px 0 18px;">
            An unexpected error occurred while processing your request.
            The details have been recorded &mdash; please try again.
        </p>
        <a class="btn-kpi" href="@Url.Action("Index", "Dashboard")">Back to Dashboard</a>
    </div>
</div>
