<?xml version="1.0" encoding="utf-8"?>

<!-- ============================================================
     Transform ที่ทำงานตอน Publish ด้วย configuration = Release
     ใช้บังคับค่าความปลอดภัยตอน deploy จริง โดยไม่รบกวนการรันบนเครื่อง dev
     ตรวจผลได้ด้วย: คลิกขวาที่ไฟล์นี้ใน Solution Explorer -> Preview Transform
     ============================================================ -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <appSettings>
    <!-- บังคับ HTTPS: redirect http -> https และส่งคุกกี้ auth เฉพาะบน HTTPS -->
    <add key="Auth:RequireHttps" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

    <!-- ห้ามสร้างบัญชีตัวอย่างบนเซิร์ฟเวอร์จริง -->
    <add key="Auth:SeedDemoUsers" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

    <!-- ถอดรหัสผ่านตัวอย่างออกจาก config ที่ deploy ไปด้วย -->
    <add key="Auth:DemoPassword" xdt:Transform="Remove" xdt:Locator="Match(key)" />
  </appSettings>

  <system.web>
    <!-- debug="false" : ปิด stack trace ที่โชว์ path จริงของเซิร์ฟเวอร์
         และเปิด optimization ของ ASP.NET (bundle ถูก minify, ไม่ recompile ทุก request) -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />

    <!-- คุกกี้ทุกตัวส่งเฉพาะบน HTTPS -->
    <httpCookies requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />
  </system.web>

</configuration>
